# Repo-wide. Each service also has its own for what only it produces.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.db
.env
# Rotation backups hold the same credentials as .env.
.env.bak-*
data/
# The investigator's and the shadow run's bind-mount roots. Same reason as
# data/, higher stakes: these hold session transcripts, distilled skills, the
# environment memory and the audit log — real hosts and real commands, in a
# public repository. `data/` alone did not cover them.
probe-data/
shadow-data/
.DS_Store
docker-compose.override.yml

# Eval data is captured production alerts — service names, hosts, thresholds.
# This repository is public: the labelled set stays local, only eval/sample.jsonl
# (synthetic) and the scripts are shared.
# The real eval set is 32 rules distilled from real production alerts, so it
# carries real alert rule names and the real Grafana folder. Ignore the CLASS,
# not one filename: an exact-name rule is what let a .bak of the pattern list
# get staged into a public repo once, and a `dataset.v2.jsonl` would slip the
# same way. sample.jsonl is the sanctioned fictional one and stays tracked.
hookjudge/eval/*.jsonl
hookjudge/eval/dataset*
!hookjudge/eval/sample.jsonl
hookjudge/eval/*.local.jsonl
hookjudge/eval/results/

# The estate identifier list is deliberately NOT in this public repo; CI reads it
# from a secret. A .bak of it is the same leak with a different name, and
# `git add -A` will stage one.
.estate-identifiers
.estate-identifiers.bak*

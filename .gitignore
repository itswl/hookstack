# Repo-wide. Each service also has its own for what only it produces.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.db
.env
# Rotation backups hold the same credentials as .env.
.env.bak-*
data/
# The investigator's and the shadow run's bind-mount roots. Same reason as
# data/, higher stakes: these hold session transcripts, distilled skills, the
# environment memory and the audit log — real hosts and real commands, in a
# public repository. `data/` alone did not cover them.
probe-data/
shadow-data/
.DS_Store
docker-compose.override.yml

# Eval data is captured production alerts — service names, hosts, thresholds.
# This repository is public: the labelled set stays local, only eval/sample.jsonl
# (synthetic) and the scripts are shared.
hookjudge/eval/dataset.jsonl
hookjudge/eval/*.local.jsonl
hookjudge/eval/results/

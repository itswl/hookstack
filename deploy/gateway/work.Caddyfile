# One address for the whole work deployment: http://127.0.0.1:8000
#
# The pipe's board is the site root — it is the reading view and the only
# service every deployment has exactly one of. Each investigator's console sits
# under a prefix, its path stripped on the way in (the consoles address their
# own API relative to where they are mounted, so the same page works here and
# on its own port). A plain proxy: no token is injected anywhere — every board
# still asks the browser for its own credential, which is what keeps this file
# free of secrets and the pipe free of every node's token.
#
# Streams (/live, /v1/live, …/stream) are NDJSON held open; flush_interval -1
# hands each line on as it arrives instead of buffering the response.
:80 {
	encode zstd gzip

	handle_path /plan/* {
		reverse_proxy probe-plan:8088 {
			flush_interval -1
		}
	}
	handle_path /watch/* {
		reverse_proxy probe-watch:8088 {
			flush_interval -1
		}
	}
	handle_path /work/* {
		reverse_proxy probe-work:8088 {
			flush_interval -1
		}
	}
	# A bare /plan (no slash) would proxy as "" — send the browser to the console.
	redir /plan /plan/ui
	redir /watch /watch/ui
	redir /work /work/ui

	handle {
		reverse_proxy hookrelay:8100 {
			flush_interval -1
		}
	}
}

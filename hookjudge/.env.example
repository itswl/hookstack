# hookjudge configuration. Copy to .env and fill in what you need.
# Empty AI settings are fine: every event lands on the rule floor and says so.

HOOKJUDGE_DB=/data/hookjudge.db

# Inbound: the secret the pipe signs its deliveries with.
HOOKJUDGE_INGEST_SECRET=
# Guards /status and /metrics.
HOOKJUDGE_READ_TOKEN=
# /rulings/ai only: the investigator's credential. Empty leaves the door shut.
HOOKJUDGE_RULING_SECRET=

# Outbound: the ONE pipe door judgements go back to.
HOOKJUDGE_RETURN_URL=http://hookrelay:8100/hook/judge-notify
HOOKJUDGE_RETURN_SECRET=

HOOKJUDGE_REUSE_WINDOW_SECONDS=3600
# How many model calls this process may have in flight at once. The identity
# lock only serializes restatements of ONE condition; a thousand different
# conditions queue here instead of stampeding the provider.
HOOKJUDGE_MAX_INFLIGHT=8
# Reuse a rule's own last AI verdict instead of paying again. Off by default:
# measure it on your eval set first (hookjudge/eval/README.md).
HOOKJUDGE_RULE_REUSE_WINDOW_SECONDS=0
# schema | tools | object to pin one; auto asks for the strongest the provider
# accepts and steps down on a format rejection.
HOOKJUDGE_AI_STRUCTURED_OUTPUT=auto
HOOKJUDGE_RETENTION_DAYS=30

HOOKJUDGE_AI_BASE_URL=
HOOKJUDGE_AI_API_KEY=
HOOKJUDGE_AI_MODEL=gpt-4o-mini
HOOKJUDGE_AI_TIMEOUT_SECONDS=60
# So the ledger can price what it spent.
HOOKJUDGE_AI_PRICE_IN_PER_1K=0
HOOKJUDGE_AI_PRICE_OUT_PER_1K=0

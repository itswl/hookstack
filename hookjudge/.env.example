# hookjudge configuration. Copy to .env and fill in what you need.
# Empty AI settings are fine: every event lands on the rule floor and says so.

HOOKJUDGE_DB=/data/hookjudge.db

# Inbound: the secret the pipe signs its deliveries with.
HOOKJUDGE_INGEST_SECRET=
# Guards /status and /metrics.
HOOKJUDGE_READ_TOKEN=

# Outbound: the ONE pipe door judgements go back to.
HOOKJUDGE_RETURN_URL=http://hookrelay:8080/hook/judge-notify
HOOKJUDGE_RETURN_SECRET=

HOOKJUDGE_REUSE_WINDOW_SECONDS=3600
HOOKJUDGE_RETENTION_DAYS=30

HOOKJUDGE_AI_BASE_URL=
HOOKJUDGE_AI_API_KEY=
HOOKJUDGE_AI_MODEL=gpt-4o-mini
HOOKJUDGE_AI_TIMEOUT_SECONDS=60
# So the ledger can price what it spent.
HOOKJUDGE_AI_PRICE_IN_PER_1K=0
HOOKJUDGE_AI_PRICE_OUT_PER_1K=0
